# Ambiente local de testes. Use somente com o serviço mysql-test do Compose.
NODE_ENV=test
PROMOSYS_API_TESTS=1
PROMOSYS_POINT_TESTS=1
HOST=127.0.0.1
PORT=3334
LOG_LEVEL=silent
API_PREFIX=/api/v1
CORS_ORIGINS=*
ENABLE_DOCS=false
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=promosys_test
DB_PASSWORD=promosys_test
DB_NAME=promosys_test
DB_CONNECTION_LIMIT=5
DB_MAX_IDLE=2
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=10000
DB_IDLE_TIMEOUT=60000

JWT_ALGORITHM=HS512
JWT_SECRET=promosys-test-access-secret-please-replace-locally-000000000000
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=promosys-test-refresh-secret-please-replace-locally-000000000000
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=promosys-api
JWT_AUDIENCE=promosys-app
BCRYPT_ROUNDS=8

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# --- Notificações (testes) -------------------------------------------------
# Os testes de integração ligam o canal e injetam um provedor falso: nenhuma
# requisição sai para a internet.
NOTIFICACOES_HABILITADAS=true
WHATSAPP_PROVEDOR=log
WHATSAPP_API_URL=http://127.0.0.1:9/nao-usado
WHATSAPP_API_KEY=chave-de-teste-nao-real
NOTIFICACOES_MAX_TENTATIVAS=3
NOTIFICACOES_BACKOFF_BASE_SEGUNDOS=5
NOTIFICACOES_BACKOFF_TETO_SEGUNDOS=60
NOTIFICACOES_LEASE_SEGUNDOS=30