# Ambiente local de testes. Use somente com o serviço mysql-test do Compose.
NODE_ENV=test
HOST=127.0.0.1
PORT=3334
LOG_LEVEL=silent
API_PREFIX=/api/v1
CORS_ORIGINS=*
ENABLE_DOCS=false
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=promosys_test
DB_PASSWORD=promosys_test
DB_NAME=promosys_test
DB_CONNECTION_LIMIT=5
DB_MAX_IDLE=2
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=10000
DB_IDLE_TIMEOUT=60000

JWT_ALGORITHM=HS512
JWT_SECRET=promosys-test-access-secret-please-replace-locally-000000000000
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=promosys-test-refresh-secret-please-replace-locally-000000000000
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=promosys-api
JWT_AUDIENCE=promosys-app
BCRYPT_ROUNDS=8

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute