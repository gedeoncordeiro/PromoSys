{
  "name": "promosys-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend do PromoSys - programa de fidelidade para varejo físico (Node.js + Fastify + MySQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "migrate": "node --env-file=.env src/database/migrate.js",
    "seed": "node --env-file=.env src/database/seed.js",
    "pontos:expirar": "node --env-file=.env src/jobs/expirar-pontos.js",
    "test:api": "node --env-file=.env.test.example --test tests/api.test.js",
    "test:points": "node --env-file=.env.test --test tests/points.integration.test.js",
    "perf:http": "node scripts/benchmark-http.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/sensible": "^6.0.2",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "autocannon": "^8.0.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "pino-pretty": "^13.0.0"
  }
}
