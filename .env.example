# ---------------------------------------------------------------------------
# PromoSys API · variáveis de ambiente
# Copie para .env e ajuste os valores:  cp .env.example .env
# Gere segredos com:  openssl rand -base64 48
# ---------------------------------------------------------------------------

# --- Aplicação -------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=debug
API_PREFIX=/api/v1
# Lista separada por vírgula. Use * apenas em desenvolvimento.
CORS_ORIGINS=*
# Habilita documentação OpenAPI em /docs (obrigatório false em produção)
ENABLE_DOCS=true
# Confie no X-Forwarded-* (use true atrás de proxy/load balancer)
TRUST_PROXY=false

# --- MySQL -----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=promosysdb
# Pool de conexões (dimensionar conforme max_connections do servidor MySQL)
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=10
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=10000
DB_IDLE_TIMEOUT=60000

# --- Autenticação ----------------------------------------------------------
# HS512 exige segredo forte (>= 64 caracteres em produção)
JWT_ALGORITHM=HS512
JWT_SECRET=TROQUE_ESTE_SEGREDO_por_um_valor_aleatorio_de_64_caracteres_minimo_000
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=TROQUE_ESTE_SEGREDO_DE_REFRESH_por_um_valor_aleatorio_de_64_caracteres_000
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=promosys-api
JWT_AUDIENCE=promosys-app
BCRYPT_ROUNDS=10

# --- Proteção / limites ----------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# --- Notificações (outbox → WhatsApp) --------------------------------------
# Desligado por padrão: com false nada é enfileirado nem enviado.
# Só entra na fila cliente com telefone válido E consentimento WHATSAPP vigente.
NOTIFICACOES_HABILITADAS=false
# 'log' = só registra a mensagem no log (dev, sem custo) | 'http' = POST JSON
WHATSAPP_PROVEDOR=log
# Obrigatória quando NOTIFICACOES_HABILITADAS=true e WHATSAPP_PROVEDOR=http
WHATSAPP_API_URL=
# Credencial do provedor: nunca versionar, nunca colar no chat, nunca logar
WHATSAPP_API_KEY=
WHATSAPP_INSTANCIA=
WHATSAPP_TIMEOUT_MS=10000
# Quantos itens o job processa por execução e quantas tentativas por item
NOTIFICACOES_LOTE=100
NOTIFICACOES_MAX_TENTATIVAS=8
# Backoff exponencial: base, 2x, 4x... até o teto (segundos)
NOTIFICACOES_BACKOFF_BASE_SEGUNDOS=60
NOTIFICACOES_BACKOFF_TETO_SEGUNDOS=21600
# Lease da reivindicação (segundos): impede dois workers no mesmo item
NOTIFICACOES_LEASE_SEGUNDOS=300
# Templates opcionais (vazio = texto padrão do código). Chaves: {primeiroNome} {pontos} {saldo} {valor} {unidade}
WHATSAPP_TEMPLATE_CREDITO=
WHATSAPP_TEMPLATE_ESTORNO=
